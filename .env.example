# Bot / Webhook
BOT_TOKEN=123456:ABC-DEF
# webhook — production (WEBHOOK_URL = public HTTPS host, not t.me)
# polling — local Docker without a public domain
BOT_MODE=polling
WEBHOOK_URL=https://bot.example.com
WEBHOOK_PATH=/webhook
WEBHOOK_SECRET=change-me-to-random-64-chars
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8080
ADMINS_TELEGRAM_IDS=

# DB
DB_HOST=postgres
DB_PORT=5432
DB_NAME=ozon_bot
DB_USER=ozon
DB_PASSWORD=change-me

# Redis
REDIS_URL=redis://redis:6379/0

# Celery
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Ozon
OZON_API_BASE=https://api-seller.ozon.ru
OZON_API_TIMEOUT=30
OZON_RATE_LIMIT_RPS=5.0
ENCRYPTION_KEY=generate-with-fernet

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/bot.log
LOG_ROTATION=100 MB
LOG_RETENTION=14 days

# Caddy
WEBHOOK_URL_HOST=localhost
